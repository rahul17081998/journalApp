<configuration>
    <!-- Console Appender with Colors -->
    <appender name="myConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%-36logger{36}) - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- File Appender with Enhanced Formatting -->
    <appender name="myFileAppender" class="ch.qos.logback.core.FileAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
        <file>journalApp.log</file>
    </appender>

    <!-- Disable noisy Kafka logs -->
    <logger name="org.apache.kafka" level="ERROR"/>
    <logger name="org.apache.kafka.clients.consumer.ConsumerConfig" level="OFF"/>
    <logger name="org.apache.kafka.clients.producer.ProducerConfig" level="OFF"/>
    <logger name="org.apache.kafka.common.utils.AppInfoParser" level="OFF"/>

    <!-- Reduce MongoDB logs -->
    <logger name="org.mongodb.driver" level="WARN"/>

    <!-- Reduce Spring Data logs -->
    <logger name="org.springframework.data" level="WARN"/>

    <!-- Root Logger Configuration -->
    <root level="INFO">
        <appender-ref ref="myConsoleAppender" />
        <appender-ref ref="myFileAppender" />
    </root>
</configuration>